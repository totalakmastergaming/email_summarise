# ========================================================
# Gmail Executive AI - Environment Configuration Template
# ========================================================

# 1. TiDB Cloud Serverless (MySQL Compatible - 5GB Free Tier)
# Get from TiDB Cloud Console -> Cluster -> Connect -> General
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=gmail_summarizer

# 2. Google Gemini API (Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 3. Google Cloud OAuth 2.0 Credentials (Gmail API)
# Created in Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_oauth_client_secret
# Run python setup_oauth.py to generate your refresh token easily:
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# 4. Your Personal Delivery Email
MY_EMAIL=your_email@gmail.com

# 5. Security Token for External Cron (cron-job.org)
CRON_SECRET=make_a_random_secure_secret_token_here_12345

# 6. Server Settings
PORT=10000
HOST=0.0.0.0
